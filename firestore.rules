rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData() != null && getUserData().role == 'admin';
    }

    // --- Security Rules ---

    match /users/{userId} {
      // يسمح للمستخدم برؤية وإنشاء ملفه، وللمدير بالتحكم الكامل
      allow get, create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // يسمح للمدير بتحديث الحالة والصلاحيات، وللمستخدم بتحديث بياناته
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // يسمح للمدير فقط برؤية القائمة أو الحذف النهائي
      allow list, delete: if isAdmin();
    }

    match /users_provision/{email} {
      // التحقق من التفعيل متاح للجميع بالبريد
      allow get: if true;
      // المدير يتحكم في طلبات التفعيل
      allow list, write: if isAdmin();
      // السماح بالحذف للمدير أو للمستخدم بعد نجاح الربط (للتنظيف)
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.token.email.lower() == email.lower());
    }

    match /clients/{clientId} {
      allow get, list: if isAdmin() || (isAuthenticated() && getUserData() != null && getUserData().clientId == clientId);
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read, list: if isAdmin() || (isAuthenticated() && getUserData() != null && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, list: if isAdmin() || (isAuthenticated() && getUserData() != null && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }
    
    match /payments/{paymentId} {
      allow read, list: if isAdmin() || (isAuthenticated() && getUserData() != null && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }
  }
}