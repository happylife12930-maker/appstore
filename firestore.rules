rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userProfileExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthenticated() && userProfileExists() && getUserData().role == 'admin';
    }

    function isClientOwner(clientId) {
      return isAuthenticated() && userProfileExists() && getUserData().clientId == clientId;
    }

    // --- Security Rules ---

    match /users/{userId} {
      allow get, update, create: if isAuthenticated() && request.auth.uid == userId;
      allow list: if isAdmin();
      allow delete: if false;
    }

    match /users_provision/{email} {
      // السماح بجلب مستند تفعيل محدد للتحقق قبل تسجيل الدخول
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /clients/{clientId} {
      allow get: if isAdmin() || isClientOwner(clientId);
      allow list, create, update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      // السماح للعميل برؤية مشاريعه بناءً على clientId المربوط في ملفه
      allow read, list: if isAdmin() || (isAuthenticated() && userProfileExists() && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, list: if isAdmin() || (isAuthenticated() && userProfileExists() && resource.data.clientId == getUserData().clientId);
      allow create, update, delete: if isAdmin();
    }
    
    match /payments/{paymentId} {
      allow read, list: if isAdmin() || (isAuthenticated() && userProfileExists() && resource.data.clientId == getUserData().clientId);
      allow create, update, delete: if isAdmin();
    }
  }
}