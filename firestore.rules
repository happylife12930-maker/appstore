rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isOwner(clientId) {
      return isAuthenticated() && getUserData().clientId == clientId;
    }

    // --- Security Rules ---

    match /users/{userId} {
      allow get, update, create: if isAuthenticated() && request.auth.uid == userId;
      allow list: if isAdmin();
      allow delete: if false;
    }

    match /users_provision/{email} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    match /clients/{clientId} {
      allow get, list: if isAdmin() || isOwner(clientId);
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      // السماح للمستفيد برؤية وقائمة مشاريعه المربوطة بـ clientId الخاص به حصراً
      allow read, list: if isAdmin() || (isAuthenticated() && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, list: if isAdmin() || (isAuthenticated() && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }
    
    match /payments/{paymentId} {
      allow read, list: if isAdmin() || (isAuthenticated() && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }
  }
}