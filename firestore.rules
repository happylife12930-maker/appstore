
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData() != null && getUserData().role == 'admin';
    }

    // --- Security Rules ---

    match /users/{userId} {
      allow get, create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read, list: if isAdmin() || (isAuthenticated() && getUserData() != null && (resource == null || resource.data.clientId == getUserData().clientId));
      allow write: if isAdmin();
    }

    match /quotations/{quotationId} {
      allow read, list: if isAuthenticated();
      allow write, delete: if isAdmin();
    }

    match /testing_groups/{groupId} {
      allow read, write, list, delete: if isAdmin();
    }

    match /support_threads/{threadId} {
      allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == threadId);
      
      match /messages/{msgId} {
        allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == threadId);
      }
    }
  }
}
