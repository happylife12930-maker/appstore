
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData() != null && getUserData().role == 'admin';
    }

    // --- Security Rules ---

    match /users/{userId} {
      allow get, update, create: if isAuthenticated() && request.auth.uid == userId;
      allow list: if isAdmin();
      allow delete: if false;
    }

    match /users_provision/{email} {
      // السماح بجلب وثيقة التفعيل بالبريد الإلكتروني للتحقق قبل أو أثناء أو بعد تسجيل الدخول
      allow get: if true; 
      allow delete: if isAuthenticated() && (request.auth.token.email.lower() == email.lower());
      allow list, write: if isAdmin();
    }

    match /clients/{clientId} {
      allow get, list: if isAdmin() || (isAuthenticated() && getUserData() != null && getUserData().clientId == clientId);
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      // السماح للمستفيد برؤية وقائمة مشاريعه المربوطة بـ clientId الخاص به
      allow read, list: if isAdmin() || (isAuthenticated() && getUserData() != null && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, list: if isAdmin() || (isAuthenticated() && getUserData() != null && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }
    
    match /payments/{paymentId} {
      allow read, list: if isAdmin() || (isAuthenticated() && getUserData() != null && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }
  }
}
