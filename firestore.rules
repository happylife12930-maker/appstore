rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow list: if isAdmin();
    }

    match /users_provision/{email} {
      allow read: if true; // السماح بالقراءة أثناء الدخول للتحقق
      allow write: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || (isAuthenticated() && getUserData().clientId == clientId);
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.clientId == getUserData().clientId || 
          resource.data.clientEmail == request.auth.token.email ||
          resource.data.clientPhone == getUserData().phone
        )
      );
      allow list, write: if isAdmin();
    }
  }
}