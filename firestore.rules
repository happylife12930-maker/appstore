rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة للتحقق مما إذا كان المستخدم مديراً
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // قواعد جدول المستخدمين
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // قواعد جدول العملاء
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }
    
    // قواعد جدول المشاريع
    match /projects/{projectId} {
      // السماح بالقراءة للأدمن، أو للعميل إذا كان المشروع يخصه بناءً على المعرف أو البريد أو الهاتف
      allow read: if request.auth != null && (
        isAdmin() || 
        resource.data.clientId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId ||
        resource.data.clientEmail == request.auth.token.email ||
        resource.data.clientPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone
      );
      allow write: if isAdmin();
    }
    
    // قواعد جدول التجهيز (بوابة المستفيد)
    match /users_provision/{email} {
      allow read, write: if isAdmin();
      allow get: if true;
    }
  }
}