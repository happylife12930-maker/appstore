
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- دالات المساعدة الأساسية ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // دالة للتحقق من الدور مباشرة دون الاعتماد على قواعد أخرى (لمنع التداخل)
    function hasRole(role) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // --- قواعد الأمان ---

    match /users/{userId} {
      // القاعدة الأساسية: المستخدم يمكنه دائماً قراءة بياناته الخاصة (تكسر التداخل المنطقي)
      allow get: if isAuthenticated() && request.auth.uid == userId;
      // المدير يمكنه قراءة أي مستخدم
      allow get, list: if isAdmin();
      // التعديل والإنشاء
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read, list: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId == resource.data.clientId);
      allow write: if isAdmin();
    }

    match /quotations/{quotationId} {
      allow read, list: if isAuthenticated();
      allow write, delete: if isAdmin();
    }

    match /testing_groups/{groupId} {
      allow read, write, list, delete: if isAdmin();
    }

    match /support_threads/{threadId} {
      allow get, write: if isAdmin() || (isAuthenticated() && request.auth.uid == threadId);
      allow list: if isAdmin();
      
      match /messages/{msgId} {
        allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == threadId);
      }
    }
  }
}
