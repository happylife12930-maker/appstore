
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // دالة جلب بيانات المستخدم لتقليل تكرار الكود
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'admin';
    }

    // --- Security Rules for 'users' collection ---
    match /users/{userId} {
      allow get: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Security Rules for 'clients' collection ---
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    // --- Security Rules for 'projects' collection ---
    match /projects/{projectId} {
      allow create, update, delete: if isAdmin();
      // الأدمن يرى الكل، والعميل يرى مشاريعه فقط بناءً على الـ clientId المربوط بحسابه
      allow read: if isAdmin() || (isAuthenticated() && resource.data.clientId == getUserData().clientId);
    }

    // --- Security Rules for 'quotations' collection ---
    match /quotations/{quotationId} {
      // عروض الأسعار (المعرض) متاح للقراءة لكل المستخدمين المسجلين
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Security Rules for 'testing_groups' collection ---
    match /testing_groups/{groupId} {
      allow read, write: if isAdmin();
    }

    // --- Security Rules for 'support_threads' collection ---
    match /support_threads/{threadId} {
      // السماح بالقراءة والكتابة والحذف للأدمن، ولصاحب المحادثة القراءة والكتابة فقط
      allow read, write: if isAdmin() || (isAuthenticated() && threadId == getUserData().clientId);
      allow delete: if isAdmin();
      
      match /messages/{msgId} {
        allow read, write: if isAdmin() || (isAuthenticated() && threadId == getUserData().clientId);
        allow delete: if isAdmin();
      }
    }

    // --- Security Rules for 'users_provision' (Activation) ---
    match /users_provision/{email} {
      allow read, write: if true; 
    }
  }
}
