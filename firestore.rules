rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة للتحقق مما إذا كان المستخدم مديراً
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // قواعد جدول المستخدمين
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    
    // قواعد جدول العملاء
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }
    
    // قواعد جدول المشاريع
    match /projects/{projectId} {
      // السماح بالقراءة للأدمن، أو للعميل إذا تطابق معرف العميل (clientId) مع المعرف المسجل في بروفايله
      allow read: if request.auth != null && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         resource.data.clientId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId)
      );
      allow write: if isAdmin();
    }
    
    // قواعد جدول التجهيز (بوابة المستفيد)
    match /users_provision/{email} {
      allow read, write: if isAdmin();
      allow get: if true;
    }
  }
}