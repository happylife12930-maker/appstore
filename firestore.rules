rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData() != null && getUserData().role == 'admin';
    }

    // --- Security Rules ---

    match /users/{userId} {
      // يسمح للمستخدم برؤية وتحديث بياناته، وللمدير بالتحكم الكامل بما في ذلك الحذف
      allow get, create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list, delete: if isAdmin();
    }

    match /users_provision/{email} {
      // التحقق من التفعيل متاح بالبريد، والمدير يتحكم في الطلبات وحذفها
      allow get: if true;
      allow list, write, delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow get, list: if isAdmin() || (isAuthenticated() && getUserData() != null && getUserData().clientId == clientId);
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read, list: if isAdmin() || (isAuthenticated() && getUserData() != null && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, list: if isAdmin() || (isAuthenticated() && getUserData() != null && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }
    
    match /payments/{paymentId} {
      allow read, list: if isAdmin() || (isAuthenticated() && getUserData() != null && resource.data.clientId == getUserData().clientId);
      allow write: if isAdmin();
    }
  }
}