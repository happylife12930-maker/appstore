
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // التحقق مما إذا كان المستخدم مديراً بشكل مباشر لتجنب التكرار
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // جلب بيانات العميل المربوطة بالحساب
    function getClientId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId;
    }

    // --- Security Rules for 'users' collection ---
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Security Rules for 'clients' collection ---
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    // --- Security Rules for 'projects' collection ---
    match /projects/{projectId} {
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin() || (isAuthenticated() && resource.data.clientId == getClientId());
    }

    // --- Security Rules for 'quotations' collection ---
    match /quotations/{quotationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Security Rules for 'testing_groups' collection ---
    match /testing_groups/{groupId} {
      allow read, write: if isAdmin();
    }

    // --- Security Rules for 'support_threads' collection ---
    match /support_threads/{threadId} {
      // السماح بالقراءة والكتابة للمدير، وللعميل فقط إذا كان المعرف يطابق clientId الخاص به
      allow read, write: if isAdmin() || (isAuthenticated() && threadId == getClientId());
      // السماح بالحذف للمدير فقط
      allow delete: if isAdmin();
      
      match /messages/{msgId} {
        allow read, write: if isAdmin() || (isAuthenticated() && threadId == getClientId());
        allow delete: if isAdmin();
      }
    }

    // --- Security Rules for 'users_provision' ---
    match /users_provision/{email} {
      allow read, write: if true; 
    }
  }
}
