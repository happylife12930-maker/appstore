
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // دالة جلب بيانات المستخدم بشكل آمن
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // التحقق من هوية المدير
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // جلب معرف العميل المربوط بالحساب
    function getClientId() {
      return getUserData().clientId;
    }

    // --- Security Rules for 'users' collection ---
    match /users/{userId} {
      allow get: if isAuthenticated() && request.auth.uid == userId;
      allow list: if isAdmin();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Security Rules for 'clients' collection ---
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Security Rules for 'projects' collection ---
    match /projects/{projectId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.clientId == getClientId());
      allow write: if isAdmin();
    }

    // --- Security Rules for 'quotations' collection ---
    match /quotations/{quotationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Security Rules for 'testing_groups' collection ---
    match /testing_groups/{groupId} {
      allow read, write: if isAdmin();
    }

    // --- Security Rules for 'support_threads' collection ---
    match /support_threads/{threadId} {
      // السماح للقراءة والكتابة والمسح للمدير
      allow read, write, delete: if isAdmin();
      // السماح للعميل بالوصول لمحادثته فقط
      allow read, write: if isAuthenticated() && threadId == getClientId();
      
      match /messages/{msgId} {
        allow read, write: if isAdmin() || (isAuthenticated() && threadId == getClientId());
        allow delete: if isAdmin();
      }
    }

    // --- Security Rules for 'users_provision' ---
    match /users_provision/{email} {
      allow read, write: if true; 
    }
  }
}
