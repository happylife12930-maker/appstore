
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user in the system with roles and permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "tester", "client"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "lastLogin": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Client": {
      "title": "Client",
      "description": "Represents a business client with financial and installment data.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "phone2": { "type": "string" },
        "company": { "type": "string" },
        "projectName": { "type": "string" },
        "totalInvoices": { "type": "number" },
        "totalPayments": { "type": "number" },
        "balance": { "type": "number" },
        "paymentType": { "type": "string", "enum": ["cash", "installments"] },
        "installments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "amount": { "type": "number" },
              "dueDate": { "type": "string", "format": "date" },
              "status": { "type": "string", "enum": ["pending", "paid"] }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SupportThread": {
      "title": "Support Thread",
      "description": "A chat thread between a client and admin.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string", "format": "date-time" },
        "unreadAdmin": { "type": "number" },
        "unreadClient": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "archived"] }
      }
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "An individual message in a support thread.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderRole": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Project": {
      "title": "Project",
      "description": "Represents a software project managed by the agency.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "requirements": { "type": "string" },
        "cost": { "type": "number" },
        "deadline": { "type": "string" },
        "progress": { "type": "number" },
        "status": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "steps": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "id": { "type": "number" },
              "title": { "type": "string" },
              "completed": { "type": "boolean" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "clientId"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "A generated or manual project quotation with AI insights and assets.",
      "type": "object",
      "properties": {
        "projectName": { "type": "string" },
        "clientName": { "type": "string" },
        "clientRequestDescription": { "type": "string" },
        "suggestedRequirements": { "type": "array", "items": { "type": "string" } },
        "estimatedCost": { "type": "number" },
        "executionTimelineDays": { "type": "number" },
        "notes": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TestingGroup": {
      "title": "Testing Group",
      "description": "Manages a group of testers for a specific project.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed"] },
        "testers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "email": { "type": "string" },
              "phone": { "type": "string" },
              "assignedDays": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "resourceLink": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "projectName"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and permissions."
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Client profile and financial records."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Project details and assets."
    },
    "/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "AI generated and manual quotations."
    },
    "/testing_groups/{groupId}": {
      "schema": "TestingGroup",
      "description": "Testing assignments and tester schedules."
    },
    "/support_threads/{threadId}": {
      "schema": "SupportThread",
      "description": "Support chat threads, where threadId is client uid."
    },
    "/support_threads/{threadId}/messages/{msgId}": {
      "schema": "ChatMessage",
      "description": "Individual messages within a support thread."
    }
  }
}
