{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user in the system with roles and permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "tester", "client"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "lastLogin": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "Represents a software project managed by the agency.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "client": { "type": "string" },
        "type": { "type": "string" },
        "progress": { "type": "number" },
        "status": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "client"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and permissions."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Project details and assets."
    }
  }
}